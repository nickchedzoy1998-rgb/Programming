    "class Solution(object):\n",
    "    def minLengthAfterRemovals(self, s):\n",
    "        \"\"\"\n",
    "        :type s: str\n",
    "        :rtype: int\n",
    "        \"\"\"\n",
    "        counts = Counter([char for char in s])\n",
    "\n",
    "        return abs(counts['a'] - counts['b'])"
   ]
